{
  "name": "@thechat/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri-cli.mjs",
    "test": "vitest run --exclude '**/*.integration.test.ts' && INTEGRATION=true vitest run integration",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "INTEGRATION=true vitest run integration && pnpm --filter @thechat/client test:integration",
    "test:watch": "vitest",
    "test:browser": "pnpm --filter @thechat/web test:browser",
    "test:e2e": "wdio run e2e/wdio.conf.js",
    "test:e2e:headless": "env -u WAYLAND_DISPLAY GDK_BACKEND=x11 xvfb-run -a wdio run e2e/wdio.conf.js",
    "vitest": "vitest"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "ajv": "^8.18.0",
    "turndown": "^7.2.2",
    "@thechat/client": "workspace:*",
    "@thechat/shared": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.11",
    "@tanstack/react-router": "^1.162.1",
    "@tanstack/react-query": "^5.100.14",
    "@tailwindcss/vite": "^4.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@thechat/api": "workspace:*",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9",
    "@wdio/local-runner": "^9",
    "@wdio/mocha-framework": "^9",
    "@wdio/spec-reporter": "^9",
    "jsdom": "^28.1.0",
    "playwright": "1.63.0",
    "react-devtools": "^7.0.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.0.18",
    "ws": "^8.19.0",
    "@elysiajs/eden": "^1.2.0"
  }
}
